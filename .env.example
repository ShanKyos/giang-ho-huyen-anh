# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Google Login (tùy chọn) ─────────────────────────────────────
# Tạo OAuth Client ID (Web) ở Google Cloud Console → Credentials.
# Authorized JavaScript origins: https://<domain> (và http://localhost:3000 khi dev)
# Đặt CẢ HAI dòng dưới vào file .env (server dotenv chỉ đọc .env; client VITE_ cũng đọc .env)
#   Server verify ID token:   GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
#   Client render nút Google: VITE_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# Lưu ý production: VITE_* được bake vào bundle lúc build → phải set trước khi npm run build.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
